---
import { Icon } from 'astro-icon/components';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import Layout from '~/layouts/Layout.astro';
import guinnessWorldRecordsPlaceholder from '~/assets/images/case-studies/hasbro-monopoly/guinness-world-records-placeholder.svg?url';
import hasbroLogo from '~/assets/images/case-studies/hasbro-monopoly/hasbro-logo.png?url';
import landlordStudioLogo from '~/assets/images/case-studies/landlord-studio/logo.png?url';
import telegraphMentionPlaceholder from '~/assets/images/case-studies/landlord-studio/telegraph-mention-placeholder.svg?url';
import { getStaticPathsCaseStudy } from '~/utils/case-studies';
import type { CaseStudy } from '~/types';

export const getStaticPaths = getStaticPathsCaseStudy;

interface Props {
  caseStudy: CaseStudy;
}

const { caseStudy } = Astro.props;
const { Content } = caseStudy;
const clientLogoBySlug: Record<string, string> = {
  'hasbro-monopoly': hasbroLogo,
  'landlord-studio': landlordStudioLogo,
};
const mentionImageBySlug: Record<string, string> = {
  'hasbro-monopoly': guinnessWorldRecordsPlaceholder,
  'landlord-studio': telegraphMentionPlaceholder,
};
const mentionTextBySlug: Record<string, { alt: string; caption: string }> = {
  'hasbro-monopoly': {
    alt: 'Placeholder for the Monopoly mention in Guinness World Records',
    caption: 'Placeholder for the Monopoly mention in Guinness World Records.',
  },
  'landlord-studio': {
    alt: 'The Telegraph headline: Landlords face £7k fine if they fail to send key document this week',
    caption: "Landlord Studio was referenced in The Telegraph, one of the UK's biggest newspapers.",
  },
};
const defaultResultsMetrics = [
  { label: 'Branded Mentions', value: 'TBC' },
  { label: 'Links', value: 'TBC' },
  { label: 'Impressions', value: 'TBC' },
];
const landlordStudioBrandImpressions = [
  118, 123, 160, 180, 197, 204, 213, 181, 195, 217, 223, 230, 225, 194, 154, 157, 154, 157, 178, 168, 163,
  165, 148, 109, 112,
];
const chartWidth = 720;
const chartHeight = 260;
const chartPadding = { top: 36, right: 18, bottom: 34, left: 46 };
const chartMin = Math.min(...landlordStudioBrandImpressions);
const chartMax = Math.max(...landlordStudioBrandImpressions);
const chartInnerWidth = chartWidth - chartPadding.left - chartPadding.right;
const chartInnerHeight = chartHeight - chartPadding.top - chartPadding.bottom;
const chartPoints = landlordStudioBrandImpressions.map((value, index) => {
  const x = chartPadding.left + (index / (landlordStudioBrandImpressions.length - 1)) * chartInnerWidth;
  const y = chartPadding.top + ((chartMax - value) / (chartMax - chartMin)) * chartInnerHeight;

  return {
    value,
    x,
    y,
  };
});
const brandImpressionsLine = chartPoints.map((point) => `${point.x},${point.y}`).join(' ');
const brandImpressionsArea = [
  `${chartPadding.left},${chartHeight - chartPadding.bottom}`,
  ...chartPoints.map((point) => `${point.x},${point.y}`),
  `${chartWidth - chartPadding.right},${chartHeight - chartPadding.bottom}`,
].join(' ');
const brandImpressionsGrid = [100, 150, 200, 230].map((value) => ({
  value,
  y: chartPadding.top + ((chartMax - value) / (chartMax - chartMin)) * chartInnerHeight,
}));
const brandImpressionsPeak = chartPoints.reduce((highest, point) => (point.value > highest.value ? point : highest), chartPoints[0]);
const brandImpressionsStart = chartPoints[0];
const brandImpressionsEnd = chartPoints[chartPoints.length - 1];
const showBrandImpressionsChart = caseStudy.slug === 'landlord-studio';
const resultsMetrics = showBrandImpressionsChart
  ? [
      { label: 'Branded Mentions', value: '17' },
      { label: 'Links', value: '4' },
      { label: 'Brand Impressions', value: '94%' },
    ]
  : defaultResultsMetrics;
const clientLogo = clientLogoBySlug[caseStudy.slug];
const mentionImage = mentionImageBySlug[caseStudy.slug];
const mentionText = mentionTextBySlug[caseStudy.slug];

const metadata = {
  title: caseStudy.metadata?.title || `${caseStudy.client} case study`,
  description: caseStudy.metadata?.description || caseStudy.subtitle,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <main class="min-h-screen bg-[#f7f4ee] text-[#141414]">
    <SiteHeader />

    <section class="border-b border-[#141414]/10">
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 sm:py-20 lg:px-8">
        <a href="/case-studies" class="inline-flex items-center gap-2 text-sm font-semibold text-[#2f5f59] hover:text-[#141414]">
          <Icon name="tabler:arrow-left" class="h-4 w-4" />
          Case studies
        </a>
        <div class="mt-8 grid gap-10 lg:grid-cols-[1fr_0.42fr] lg:items-start">
          <div>
            {
              clientLogo ? (
                <img
                  src={clientLogo}
                  alt={`${caseStudy.client} logo`}
                  class="h-10 w-auto max-w-64 object-contain"
                  loading="eager"
                />
              ) : (
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#e2634f]">{caseStudy.client}</p>
              )
            }
            <h1 class="mt-5 max-w-4xl text-5xl font-semibold leading-[1.02] tracking-normal sm:text-6xl">
              {caseStudy.title}
            </h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-[#454545] sm:text-xl">{caseStudy.subtitle}</p>
          </div>

          <aside class="rounded-sm border border-[#141414]/10 bg-white p-6">
            <dl class="grid gap-5">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-[#777]">Client</dt>
                <dd class="mt-1 text-lg font-semibold">{caseStudy.client}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-[#777]">Campaign type</dt>
                <dd class="mt-1 text-lg font-semibold">{caseStudy.campaignType}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-[#777]">Outcome</dt>
                <dd class="mt-1 leading-7 text-[#555]">{caseStudy.outcome}</dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-6 lg:grid-cols-[0.32fr_1fr] lg:px-8 lg:py-20">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#2f5f59]">Project</p>
        </div>
        <div>
          <p class="text-2xl font-semibold leading-10 tracking-normal text-[#141414]">{caseStudy.project}</p>
          {
            Content && (
              <div class="prose prose-lg mt-10 max-w-none prose-headings:tracking-normal prose-a:text-[#2f5f59] prose-strong:text-[#141414]">
                <Content />
              </div>
            )
          }
        </div>
      </div>
    </section>

    {
      caseStudy.storyWeTold && (
        <section class="border-t border-[#141414]/10 bg-[#f7f4ee]">
          <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-6 lg:grid-cols-[0.32fr_1fr] lg:px-8 lg:py-20">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#e2634f]">The story we told</p>
            </div>
            <div>
              <p class="max-w-4xl text-2xl font-semibold leading-10 tracking-normal text-[#141414]">
                {caseStudy.storyWeTold}
              </p>
            </div>
          </div>
        </section>
      )
    }

    <section class="border-y border-[#141414]/10 bg-white">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-6 lg:grid-cols-[0.32fr_1fr] lg:px-8 lg:py-20">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#e2634f]">Results</p>
        </div>
        <div>
          <div class="grid gap-4 md:grid-cols-3">
            {
              resultsMetrics.map((metric) => (
                <article class="result-metric rounded-sm border border-[#141414]/10 bg-white p-6">
                  <p class="text-4xl font-semibold tracking-normal text-[#141414] sm:text-5xl">{metric.value}</p>
                  <p class="mt-4 text-sm font-semibold uppercase tracking-[0.16em] text-[#2f5f59]">{metric.label}</p>
                </article>
              ))
            }
          </div>
          {
            showBrandImpressionsChart && (
              <figure class="mt-8 rounded-sm border border-[#141414]/10 bg-white p-5 sm:p-6">
                <div>
                  <h2 class="text-3xl font-semibold tracking-normal sm:text-4xl">Brand Impressions</h2>
                </div>
                <div class="mt-6 overflow-x-auto">
                  <svg
                    viewBox={`0 0 ${chartWidth} ${chartHeight}`}
                    role="img"
                    aria-label="Line graph showing Landlord Studio brand impressions rising from 118,000 to a peak of 230,000."
                    class="min-w-[42rem] w-full"
                  >
                    <polygon points={brandImpressionsArea} fill="#dce8d8" opacity="0.78" />
                    {
                      brandImpressionsGrid.map((line) => (
                        <>
                          <line
                            x1={chartPadding.left}
                            x2={chartWidth - chartPadding.right}
                            y1={line.y}
                            y2={line.y}
                            stroke="#141414"
                            stroke-opacity="0.1"
                          />
                          <text x="8" y={line.y + 4} fill="#555" font-size="12" font-weight="600">
                            {line.value}k
                          </text>
                        </>
                      ))
                    }
                    <line
                      x1={chartPadding.left}
                      x2={chartWidth - chartPadding.right}
                      y1={chartHeight - chartPadding.bottom}
                      y2={chartHeight - chartPadding.bottom}
                      stroke="#141414"
                      stroke-opacity="0.18"
                    />
                    <polyline
                      points={brandImpressionsLine}
                      fill="none"
                      stroke="#2f5f59"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="4"
                    />
                    <circle cx={brandImpressionsStart.x} cy={brandImpressionsStart.y} r="5" fill="#2f5f59" />
                    <circle cx={brandImpressionsPeak.x} cy={brandImpressionsPeak.y} r="6" fill="#e2634f" />
                    <circle cx={brandImpressionsEnd.x} cy={brandImpressionsEnd.y} r="5" fill="#2f5f59" />
                    <text x={brandImpressionsStart.x - 18} y={brandImpressionsStart.y - 14} fill="#141414" font-size="13" font-weight="700">
                      118k
                    </text>
                    <text x={brandImpressionsPeak.x - 20} y={brandImpressionsPeak.y - 14} fill="#141414" font-size="13" font-weight="700">
                      230k
                    </text>
                    <text x={brandImpressionsEnd.x - 20} y={brandImpressionsEnd.y - 14} fill="#141414" font-size="13" font-weight="700">
                      112k
                    </text>
                    <text x={chartPadding.left} y={chartHeight - 8} fill="#555" font-size="12" font-weight="600">
                      Start
                    </text>
                    <text x={brandImpressionsPeak.x - 14} y={chartHeight - 8} fill="#555" font-size="12" font-weight="600">
                      Peak
                    </text>
                    <text x={chartWidth - chartPadding.right - 22} y={chartHeight - 8} fill="#555" font-size="12" font-weight="600">
                      End
                    </text>
                  </svg>
                </div>
                <figcaption class="mt-4 text-sm leading-6 text-[#555]">
                  Brand impressions across 25 data points, beginning at 118,000, peaking at 230,000, and ending at
                  112,000.
                </figcaption>
              </figure>
            )
          }
          {
            mentionImage && (
              <figure class="mt-8 overflow-hidden rounded-sm border border-[#141414]/10 bg-white">
                <img
                  src={mentionImage}
                  alt={mentionText?.alt || 'Placeholder for media mention'}
                  class="aspect-[12/7] w-full object-cover"
                  loading="lazy"
                />
                <figcaption class="border-t border-[#141414]/10 px-5 py-4 text-sm leading-6 text-[#555]">
                  {mentionText?.caption || 'Placeholder for media mention.'}
                </figcaption>
              </figure>
            )
          }
        </div>
      </div>
    </section>

    <section class="border-y border-[#141414]/10 bg-[#f7f4ee]">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-6 lg:grid-cols-[0.32fr_1fr] lg:px-8 lg:py-20">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#e2634f]">
            What research-led stories give you
          </p>
        </div>
        <div>
          <h2 class="max-w-3xl text-3xl font-semibold tracking-normal sm:text-5xl">
            Evidence that turns brand expertise into something people can use.
          </h2>
          <div class="mt-10 grid gap-4 md:grid-cols-3">
            <article class="rounded-sm border border-[#141414]/10 bg-white p-6">
              <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#2f5f59]">Unique evidence</p>
              <h3 class="mt-4 text-xl font-semibold">A stronger reason to care</h3>
              <p class="mt-4 leading-7 text-[#555]">
                Data gives the story a foundation competitors cannot easily copy or reduce to opinion.
              </p>
            </article>
            <article class="rounded-sm border border-[#141414]/10 bg-white p-6">
              <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#2f5f59]">Clear angle</p>
              <h3 class="mt-4 text-xl font-semibold">A story people can understand</h3>
              <p class="mt-4 leading-7 text-[#555]">
                Research turns complexity into a timely, media-ready angle with relevance beyond the brand.
              </p>
            </article>
            <article class="rounded-sm border border-[#141414]/10 bg-white p-6">
              <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#2f5f59]">Visible authority</p>
              <h3 class="mt-4 text-xl font-semibold">Attention backed by credibility</h3>
              <p class="mt-4 leading-7 text-[#555]">
                The output helps the brand earn coverage, mentions, trust, and visibility from something substantive.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[#141414] text-white">
      <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 sm:px-6 lg:grid-cols-[1fr_auto] lg:items-center lg:px-8">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#f2c36b]">Start here</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-normal sm:text-5xl">
            Find your story to share with the world.
          </h2>
        </div>
        <a
          href="/book-a-meeting"
          class="inline-flex items-center justify-center gap-2 rounded-sm bg-white px-6 py-3.5 font-semibold text-[#141414] transition hover:bg-[#f2c36b]"
        >
          Book a discovery call
          <Icon name="tabler:arrow-up-right" class="h-5 w-5" />
        </a>
      </div>
    </section>

    <SiteFooter />
  </main>
</Layout>

<style>
  .result-metric {
    transition:
      border-color 180ms ease,
      transform 180ms ease;
  }

  .result-metric:hover {
    border-color: rgb(47 95 89 / 0.4);
    transform: translateY(-2px);
  }
</style>
