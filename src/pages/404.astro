---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/Layout.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteHeader from '~/components/SiteHeader.astro';

const title = 'Page not found';
const description = 'This page could not be found. Return to Cited Stories or contact us for help.';
---

<Layout metadata={{ title, description }}>
  <main class="min-h-screen bg-[#f7f4ee] text-[#141414]">
    <SiteHeader />

    <section class="border-b border-[#141414]/10">
      <div class="mx-auto grid min-h-[62vh] max-w-7xl items-center gap-10 px-5 py-16 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8 lg:py-24">
        <div class="rounded-sm border border-[#141414]/10 bg-white p-8 shadow-[0_24px_80px_rgba(20,20,20,0.08)]">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#e2634f]">404</p>
          <h1 class="mt-4 text-4xl font-semibold leading-[1.02] tracking-normal sm:text-6xl">This page has gone quiet.</h1>
          <p class="mt-5 text-lg leading-8 text-[#454545]">
            The page you were looking for is not here, but the rest of Cited Stories is close by.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href="/"
              class="inline-flex items-center justify-center gap-2 rounded-sm bg-[#141414] px-6 py-3.5 font-semibold text-white transition hover:bg-[#2f5f59]"
            >
              Back to homepage
              <Icon name="tabler:arrow-right" class="h-5 w-5" />
            </a>
            <a
              href="/contact"
              class="inline-flex items-center justify-center gap-2 rounded-sm border border-[#141414]/20 bg-[#f7f4ee] px-6 py-3.5 font-semibold text-[#141414] transition hover:border-[#2f5f59] hover:text-[#2f5f59]"
            >
              Contact us
              <Icon name="tabler:mail" class="h-5 w-5" />
            </a>
          </div>
        </div>

        <div class="hidden lg:block">
          <svg viewBox="0 0 520 360" role="img" aria-label="Abstract citation paths reconnecting to Cited Stories" class="h-auto w-full">
            <rect x="40" y="42" width="170" height="110" rx="4" fill="#ffffff" stroke="#141414" stroke-opacity="0.12" />
            <rect x="310" y="58" width="150" height="96" rx="4" fill="#141414" />
            <rect x="92" y="230" width="160" height="86" rx="4" fill="#dce8d8" />
            <path d="M210 102 C260 102 265 106 310 106" fill="none" stroke="#e2634f" stroke-width="4" stroke-linecap="round" />
            <path d="M232 268 C286 258 308 212 346 154" fill="none" stroke="#2f5f59" stroke-width="4" stroke-linecap="round" />
            <path d="M300 106 l-14 -10 M300 106 l-14 10" fill="none" stroke="#e2634f" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="125" cy="96" r="18" fill="#f2c36b" />
            <circle cx="385" cy="106" r="18" fill="#dce8d8" />
            <circle cx="172" cy="273" r="18" fill="#2f5f59" />
            <g fill="#141414" fill-opacity="0.18">
              <rect x="78" y="123" width="92" height="7" rx="2" />
              <rect x="338" y="128" width="84" height="7" rx="2" />
              <rect x="126" y="291" width="94" height="7" rx="2" />
            </g>
          </svg>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Layout>
