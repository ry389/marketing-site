---
import { Icon } from 'astro-icon/components';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import Layout from '~/layouts/Layout.astro';

const metadata = {
  title: 'About Cited Stories',
  description:
    'Cited Stories helps companies become trusted sources through data, research-led stories, and authority-building campaigns.',
  ignoreTitleTemplate: true,
};

const principles = [
  {
    title: 'Evidence before opinion',
    description: 'We look for data, patterns, and proof points before deciding what a brand should say.',
  },
  {
    title: 'Stories people can reference',
    description: 'We turn research into assets that journalists, customers, partners, and search engines can cite.',
  },
  {
    title: 'Authority that compounds',
    description: 'We build campaigns that keep earning visibility after the first launch window has passed.',
  },
];
---

<Layout metadata={metadata}>
  <main class="min-h-screen bg-[#f7f4ee] text-[#141414]">
    <SiteHeader />

    <section class="border-b border-[#141414]/10">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-6 sm:py-20 lg:grid-cols-[0.95fr_1.05fr] lg:px-8 lg:py-24">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#e2634f]">About</p>
          <h1 class="mt-5 max-w-4xl text-5xl font-semibold leading-[1.02] tracking-normal sm:text-6xl">
            In a world of AI noise, brands need something real to say.
          </h1>
          <p class="mt-6 max-w-2xl text-3xl font-semibold leading-tight tracking-normal text-[#2f5f59] sm:text-4xl">
            We help you say it.
          </p>
        </div>
        <div class="self-end">
          <div class="aspect-video rounded-sm border border-[#141414]/10 bg-[#141414] p-4 text-white shadow-[0_24px_80px_rgba(20,20,20,0.10)]">
            <div class="flex h-full flex-col justify-between rounded-sm border border-white/10 bg-white/5 p-5">
              <div class="flex items-center justify-between text-sm text-white/60">
                <span>Brand authority film</span>
                <Icon name="tabler:video" class="h-5 w-5" />
              </div>
              <div class="flex items-center justify-center">
                <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white text-[#141414]">
                  <Icon name="tabler:player-play-filled" class="h-7 w-7" />
                </span>
              </div>
              <div class="grid grid-cols-3 gap-2">
                <span class="h-2 rounded-sm bg-[#dce8d8]"></span>
                <span class="h-2 rounded-sm bg-[#f2c36b]"></span>
                <span class="h-2 rounded-sm bg-[#e2634f]"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-[#141414]/10 bg-white">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-6 lg:grid-cols-[1fr_0.85fr] lg:items-center lg:px-8 lg:py-20">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#2f5f59]">What we do</p>
          <p class="mt-5 text-xl leading-9 text-[#343434]">
            Cited Stories exists for companies that want to shape industry conversations, not just publish more
            content. We uncover data, develop research-led stories, and create campaigns that help brands earn trust
            across media, search, social, newsletters, and AI-driven discovery.
          </p>
          <p class="mt-6 text-lg leading-8 text-[#555]">
            The work sits between strategy, research, PR, SEO, and thought leadership. The goal is simple: give your
            market something credible to reference.
          </p>
        </div>
        <div class="rounded-sm border border-[#141414]/10 bg-[#f7f4ee] p-5">
          <div class="aspect-[4/3] rounded-sm bg-white p-5">
            <div class="grid h-full grid-rows-[1fr_auto] gap-5">
              <div class="grid grid-cols-3 items-end gap-4">
                <div class="h-24 rounded-sm bg-[#dce8d8]"></div>
                <div class="h-40 rounded-sm bg-[#f2c36b]"></div>
                <div class="h-32 rounded-sm bg-[#e2634f]"></div>
              </div>
              <div>
                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#2f5f59]">Placeholder image</p>
                <p class="mt-2 text-lg font-semibold">Research, story, authority</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-[#141414]/10 bg-white">
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 lg:px-8 lg:py-20">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#2f5f59]">How we think</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-normal sm:text-5xl">Authority starts with proof.</h2>
        </div>
        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {
            principles.map((item) => (
              <article class="rounded-sm border border-[#141414]/10 bg-[#f7f4ee] p-6">
                <h3 class="text-xl font-semibold">{item.title}</h3>
                <p class="mt-4 leading-7 text-[#555]">{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-[#141414] text-white">
      <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 sm:px-6 lg:grid-cols-[1fr_auto] lg:items-center lg:px-8">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#f2c36b]">Start here</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-normal sm:text-5xl">Find the story your market should cite.</h2>
        </div>
        <a
          href="/book-a-meeting"
          class="inline-flex items-center justify-center gap-2 rounded-sm bg-white px-6 py-3.5 font-semibold text-[#141414] transition hover:bg-[#f2c36b]"
        >
          Book a discovery call
          <Icon name="tabler:arrow-up-right" class="h-5 w-5" />
        </a>
      </div>
    </section>

    <SiteFooter />
  </main>
</Layout>
