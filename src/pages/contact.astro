---
import { Icon } from 'astro-icon/components';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import Layout from '~/layouts/Layout.astro';
import contactEmailImage from '~/assets/images/contact/contact-email.png';

const metadata = {
  title: 'Contact',
  description: 'Send Cited Stories a message about research-led content, digital PR, and authority-building campaigns.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <main class="min-h-screen bg-[#f7f4ee] text-[#141414]">
    <SiteHeader />

    <section class="border-b border-[#141414]/10">
      <div class="mx-auto grid max-w-5xl gap-8 px-5 py-16 sm:px-6 sm:py-20 lg:grid-cols-[minmax(0,48rem)_12rem] lg:items-end lg:px-8">
        <div class="max-w-3xl">
          <h1 class="mt-5 text-5xl font-semibold leading-[1.02] tracking-normal sm:text-6xl">
            Have a question?
            <br />
            Let’s talk.
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-[#454545] sm:text-xl">
            Tell us what you need help with, and we’ll come back to you within 2 working days with a reply.
          </p>
        </div>
        <div class="flex items-center justify-center lg:justify-end">
          <img
            src={contactEmailImage.src}
            width={contactEmailImage.width}
            height={contactEmailImage.height}
            alt="Illustration of a person sending a message"
            loading="eager"
            class="h-auto w-full max-w-48 object-contain"
          />
        </div>
      </div>
    </section>

    <section id="contact-form" class="border-b border-[#141414]/10 bg-white">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-6 lg:grid-cols-[0.75fr_1.25fr] lg:px-8 lg:py-20">
        <div>
          <h2 class="text-3xl font-semibold tracking-normal sm:text-5xl">Send us a message.</h2>
          <p class="mt-5 max-w-xl text-lg leading-8 text-[#555]">
            Share a little context about what you need, and we’ll reply within 2 working days.
          </p>
          <div class="mt-6 flex items-center gap-3">
            <a
              href="mailto:hello@citedstories.com"
              class="inline-flex h-11 w-11 items-center justify-center rounded-sm border border-[#141414]/10 bg-[#f7f4ee] text-[#141414] transition hover:border-[#2f5f59]/40 hover:bg-white hover:text-[#2f5f59]"
              aria-label="Email Cited Stories"
            >
              <Icon name="tabler:mail" class="h-5 w-5" />
            </a>
            <a
              href="https://www.linkedin.com/in/ryangreenio/"
              class="inline-flex h-11 w-11 items-center justify-center rounded-sm border border-[#141414]/10 bg-[#f7f4ee] text-[#141414] transition hover:border-[#2f5f59]/40 hover:bg-white hover:text-[#2f5f59]"
              aria-label="Ryan Green on LinkedIn"
              rel="noopener noreferrer"
              target="_blank"
            >
              <Icon name="tabler:brand-linkedin" class="h-5 w-5" />
            </a>
          </div>
        </div>

        <div
          class="rounded-sm border border-[#141414]/10 bg-[#f7f4ee] p-5 shadow-[0_24px_80px_rgba(20,20,20,0.08)] sm:p-6"
          data-contact-panel
        >
          <div
            class="hidden rounded-sm border border-[#2f5f59]/20 bg-[#dce8d8] p-6 text-[#21443f] sm:p-8"
            data-contact-success
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-sm bg-white text-[#2f5f59]">
              <Icon name="tabler:circle-check" class="h-7 w-7" />
            </div>
            <h3 class="mt-6 text-2xl font-semibold tracking-normal text-[#141414] sm:text-3xl">Thanks.</h3>
            <p class="mt-3 text-lg leading-8 text-[#21443f]">
              Your message has been sent. We'll be in touch!
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a
                href="/"
                class="inline-flex items-center justify-center gap-2 rounded-sm bg-[#141414] px-5 py-3 font-semibold text-white transition hover:bg-[#2f5f59]"
              >
                Back to home
                <Icon name="tabler:arrow-right" class="h-5 w-5" />
              </a>
              <a
                href="/contact"
                class="inline-flex items-center justify-center gap-2 rounded-sm border border-[#2f5f59]/30 px-5 py-3 font-semibold text-[#21443f] transition hover:bg-white"
              >
                Contact us
                <Icon name="tabler:calendar-event" class="h-5 w-5" />
              </a>
            </div>
          </div>

          <form
            name="contact"
            method="POST"
            action="/contact?submitted=true"
            netlify
            data-netlify="true"
            netlify-honeypot="company"
            data-contact-form
            class="grid gap-4"
          >
            <input type="hidden" name="form-name" value="contact" />
            <input type="hidden" name="recipient" value="hello@citedstories.com" />
            <p class="hidden">
              <label>
                Do not fill this out if you are human:
                <input name="company" tabindex="-1" autocomplete="off" />
              </label>
            </p>

            <label class="grid gap-2 text-sm font-semibold text-[#343434]">
              <span>Name <span class="text-[#e2634f]" aria-hidden="true">*</span></span>
              <input
                type="text"
                name="name"
                autocomplete="name"
                placeholder="Enter your full name"
                required
                aria-required="true"
                class="h-11 rounded-sm border border-[#141414]/15 bg-[#f7f4ee] px-4 text-base font-normal outline-none transition focus:border-[#2f5f59] focus:bg-white"
              />
            </label>

            <label class="grid gap-2 text-sm font-semibold text-[#343434]">
              <span>Email <span class="text-[#e2634f]" aria-hidden="true">*</span></span>
              <input
                type="email"
                name="email"
                autocomplete="email"
                placeholder="Enter your email address"
                required
                aria-required="true"
                class="h-11 rounded-sm border border-[#141414]/15 bg-[#f7f4ee] px-4 text-base font-normal outline-none transition focus:border-[#2f5f59] focus:bg-white"
              />
            </label>

            <label class="grid gap-2 text-sm font-semibold text-[#343434]">
              <span>Your Message <span class="text-[#e2634f]" aria-hidden="true">*</span></span>
              <textarea
                name="message"
                rows="5"
                placeholder="Tell us what you need help with"
                required
                aria-required="true"
                class="resize-y rounded-sm border border-[#141414]/15 bg-[#f7f4ee] px-4 py-3 text-base font-normal leading-7 outline-none transition focus:border-[#2f5f59] focus:bg-white"
              ></textarea>
            </label>

            <button
              type="submit"
              class="inline-flex h-11 items-center justify-center gap-2 rounded-sm bg-[#141414] px-6 font-semibold text-white transition hover:bg-[#2f5f59]"
            >
              Send message
              <Icon name="tabler:send" class="h-5 w-5" />
            </button>
          </form>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>

  <script is:inline data-astro-rerun>
    const contactForm = document.querySelector('[data-contact-form]');
    const successMessage = document.querySelector('[data-contact-success]');
    const contactPanel = document.querySelector('[data-contact-panel]');
    const contactSubmitted = new URLSearchParams(window.location.search).get('submitted') === 'true';

    const getSessionValue = (key) => {
      try {
        return sessionStorage.getItem(key);
      } catch {
        return null;
      }
    };

    const setSessionValue = (key, value) => {
      try {
        sessionStorage.setItem(key, value);
      } catch {}
    };

    const removeSessionValue = (key) => {
      try {
        sessionStorage.removeItem(key);
      } catch {}
    };

    const trackContactSubmission = () => {
      const pendingKey = 'citedStoriesContactSubmissionPending';
      const sentKey = 'citedStoriesContactSubmissionTracked';

      if (getSessionValue(pendingKey) !== 'true' || getSessionValue(sentKey) === 'true') return;

      const eventParams = {
        event_category: 'lead',
        event_label: 'Contact form',
        form_name: 'contact',
        form_destination: 'hello@citedstories.com',
        conversion_page: '/contact',
      };

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'contact_form_submitted',
        ...eventParams,
      });

      if (typeof window.gtag === 'function') {
        window.gtag('event', 'contact_form_submitted', eventParams);
      }

      setSessionValue(sentKey, 'true');
      removeSessionValue(pendingKey);
    };

    if (successMessage && contactForm && contactSubmitted) {
      successMessage.classList.remove('hidden');
      contactForm.classList.add('hidden');
      contactPanel?.classList.remove('shadow-[0_24px_80px_rgba(20,20,20,0.08)]');
      contactPanel?.classList.add('bg-white');
      trackContactSubmission();
    }

    contactForm?.querySelector('[name="name"]')?.addEventListener('invalid', (event) => {
      event.target.setCustomValidity('Please enter your name.');
    });
    contactForm?.querySelector('[name="email"]')?.addEventListener('invalid', (event) => {
      event.target.setCustomValidity('Please enter a valid email address.');
    });
    contactForm?.querySelector('[name="message"]')?.addEventListener('invalid', (event) => {
      event.target.setCustomValidity('Please enter your message.');
    });
    contactForm?.querySelectorAll('[required]').forEach((field) => {
      field.addEventListener('input', () => field.setCustomValidity(''));
    });

    contactForm?.addEventListener('submit', (event) => {
      if (contactForm.dataset.conversionSent === 'true') return;

      if (!contactForm.reportValidity()) {
        return;
      }

      event.preventDefault();
      contactForm.dataset.conversionSent = 'true';
      setSessionValue('citedStoriesContactSubmissionPending', 'true');
      removeSessionValue('citedStoriesContactSubmissionTracked');

      let hasSubmitted = false;
      const submitForm = () => {
        if (hasSubmitted) return;
        hasSubmitted = true;
        HTMLFormElement.prototype.submit.call(contactForm);
      };

      submitForm();
    });
  </script>
</Layout>
