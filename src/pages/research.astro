---
import { Icon } from 'astro-icon/components';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import Layout from '~/layouts/Layout.astro';
import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

const posts = await fetchPosts();

const metadata = {
  title: 'Research',
  description: 'Research, data stories, and authority-building thinking from Cited Stories.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <main class="min-h-screen bg-[#f7f4ee] text-[#141414]">
    <SiteHeader />

    <section class="border-b border-[#141414]/10">
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 sm:py-20 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#e2634f]">Research</p>
          <h1 class="mt-5 text-5xl font-semibold leading-[1.02] tracking-normal sm:text-6xl">
            Data stories, thinking, and evidence worth citing.
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-[#454545] sm:text-xl">
            Notes on research-led PR, search authority, thought leadership, and the ideas that help brands become
            trusted sources.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto max-w-7xl px-5 py-14 sm:px-6 lg:px-8 lg:py-16">
        {
          posts.length > 0 ? (
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {posts.map((post) => (
                <article class="flex min-h-full flex-col rounded-sm border border-[#141414]/10 bg-[#f7f4ee] p-6 transition hover:-translate-y-1 hover:border-[#2f5f59]/40 hover:bg-white">
                  <div class="flex items-center gap-2 text-sm font-medium text-[#666]">
                    <Icon name="tabler:calendar" class="h-4 w-4 text-[#2f5f59]" />
                    <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
                  </div>
                  <h2 class="mt-5 text-2xl font-semibold leading-tight tracking-normal">
                    <a href={getPermalink(post.permalink, 'post')} class="hover:text-[#2f5f59]">
                      {post.title}
                    </a>
                  </h2>
                  {post.excerpt && <p class="mt-4 leading-7 text-[#555]">{post.excerpt}</p>}
                  <a
                    href={getPermalink(post.permalink, 'post')}
                    class="mt-8 inline-flex items-center gap-2 font-semibold text-[#141414] hover:text-[#2f5f59]"
                  >
                    Read more
                    <Icon name="tabler:arrow-right" class="h-5 w-5" />
                  </a>
                </article>
              ))}
            </div>
          ) : (
            <div class="rounded-sm border border-[#141414]/10 bg-[#f7f4ee] p-8 text-center">
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#2f5f59]">Coming soon</p>
              <h2 class="mt-3 text-3xl font-semibold tracking-normal">Research will live here.</h2>
              <p class="mx-auto mt-4 max-w-xl leading-7 text-[#555]">
                This page is ready for articles, reports, campaign notes, and research-led thinking.
              </p>
            </div>
          )
        }
      </div>
    </section>

    <SiteFooter />
  </main>
</Layout>
