---
import { Icon } from 'astro-icon/components';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import Layout from '~/layouts/Layout.astro';
import researchHeroSticker from '~/assets/images/research/research-hero-sticker.png?url';
import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';
import type { Taxonomy } from '~/types';

const posts = await fetchPosts();
const filterOptions = Array.from(
  new Map(
    posts
      .flatMap((post) => [post.category, ...(post.tags || [])])
      .filter((item): item is Taxonomy => Boolean(item))
      .map((item) => [item.slug, item.title])
  )
);

const metadata = {
  title: 'Research',
  description: 'Research, data stories, and authority-building thinking from Cited Stories.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <main class="min-h-screen bg-[#f7f4ee] text-[#141414]">
    <SiteHeader />

    <section class="border-b border-[#141414]/10">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-6 sm:py-20 lg:grid-cols-[1fr_12rem] lg:items-end lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#e2634f]">Research</p>
          <h1 class="mt-5 text-5xl font-semibold leading-[1.02] tracking-normal sm:text-6xl">
            Data stories, thinking, and evidence worth citing.
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-[#454545] sm:text-xl">
            Notes on research-led PR, search authority, thought leadership, and the ideas that help brands become
            trusted sources.
          </p>
        </div>
        <div class="flex justify-center self-end lg:justify-end">
          <img
            src={researchHeroSticker}
            alt="Illustration of a person reading research"
            class="h-auto w-full max-w-48 object-contain"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto max-w-7xl px-5 py-14 sm:px-6 lg:px-8 lg:py-16">
        <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-center">
          <label class="relative block w-full md:max-w-md">
            <span class="sr-only">Search research</span>
            <Icon name="tabler:search" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-[#777]" />
            <input
              type="search"
              placeholder="Search research"
              class="h-12 w-full rounded-sm border border-[#141414]/15 bg-[#f7f4ee] pl-11 pr-4 text-base outline-none transition focus:border-[#2f5f59] focus:bg-white"
              data-list-search
            />
          </label>
          <label class="grid w-full gap-2 text-sm font-semibold text-[#343434] md:w-72">
            <span class="sr-only">Filter research</span>
            <select
              class="h-12 rounded-sm border border-[#141414]/15 bg-[#f7f4ee] px-4 text-base font-normal outline-none transition focus:border-[#2f5f59] focus:bg-white"
              data-list-filter
            >
              <option value="">All categories</option>
              {filterOptions.map(([slug, title]) => <option value={slug}>{title}</option>)}
            </select>
          </label>
        </div>
        {
          posts.length > 0 ? (
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {posts.map((post) => (
                <article
                  class="flex min-h-full flex-col rounded-sm border border-[#141414]/10 bg-[#f7f4ee] p-6 transition hover:-translate-y-1 hover:border-[#2f5f59]/40 hover:bg-white"
                  data-list-item
                  data-search-index={`${post.title} ${post.excerpt || ''} ${post.category?.title || ''} ${(post.tags || []).map((tag) => tag.title).join(' ')}`.toLowerCase()}
                  data-filter-index={[post.category?.slug, ...(post.tags || []).map((tag) => tag.slug)].filter(Boolean).join(' ')}
                >
                  <div class="flex items-center gap-2 text-sm font-medium text-[#666]">
                    <Icon name="tabler:calendar" class="h-4 w-4 text-[#2f5f59]" />
                    <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
                  </div>
                  <h2 class="mt-5 text-2xl font-semibold leading-tight tracking-normal">
                    <a href={getPermalink(post.permalink, 'post')} class="hover:text-[#2f5f59]">
                      {post.title}
                    </a>
                  </h2>
                  {post.excerpt && <p class="mt-4 leading-7 text-[#555]">{post.excerpt}</p>}
                  <a
                    href={getPermalink(post.permalink, 'post')}
                    class="mt-8 inline-flex items-center gap-2 font-semibold text-[#141414] hover:text-[#2f5f59]"
                  >
                    Read more
                    <Icon name="tabler:arrow-right" class="h-5 w-5" />
                  </a>
                </article>
              ))}
            </div>
          ) : (
            <div class="rounded-sm border border-[#141414]/10 bg-[#f7f4ee] p-8 text-center">
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#2f5f59]">Coming soon</p>
              <h2 class="mt-3 text-3xl font-semibold tracking-normal">Research will live here.</h2>
              <p class="mx-auto mt-4 max-w-xl leading-7 text-[#555]">
                This page is ready for articles, reports, campaign notes, and research-led thinking.
              </p>
            </div>
          )
        }
        <div class="hidden rounded-sm border border-[#141414]/10 bg-[#f7f4ee] p-8 text-center" data-list-empty>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#2f5f59]">No matches</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-normal">Try another search or filter.</h2>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>

  <script is:inline data-astro-rerun>
    const searchInput = document.querySelector('[data-list-search]');
    const filterSelect = document.querySelector('[data-list-filter]');
    const listItems = Array.from(document.querySelectorAll('[data-list-item]'));
    const emptyState = document.querySelector('[data-list-empty]');

    const updateList = () => {
      const query = searchInput.value.trim().toLowerCase();
      const filter = filterSelect.value;
      let visibleCount = 0;

      listItems.forEach((item) => {
        const matchesSearch = !query || item.dataset.searchIndex.includes(query);
        const matchesFilter = !filter || item.dataset.filterIndex.split(' ').includes(filter);
        const isVisible = matchesSearch && matchesFilter;
        item.classList.toggle('hidden', !isVisible);
        if (isVisible) visibleCount += 1;
      });

      emptyState.classList.toggle('hidden', visibleCount !== 0);
    };

    searchInput.addEventListener('input', updateList);
    filterSelect.addEventListener('change', updateList);
  </script>
</Layout>
