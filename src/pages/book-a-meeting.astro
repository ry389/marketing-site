---
import { Icon } from 'astro-icon/components';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import Layout from '~/layouts/Layout.astro';
import ryanProfile from '~/assets/images/meeting-booking/ryan-profile.jpeg';

const metadata = {
  title: 'Book a discovery call',
  description: 'Choose a time to discuss research-led PR, SEO, and thought leadership opportunities.',
  ignoreTitleTemplate: true,
};

const discussionPoints = [
  'Where your brand can credibly own a topic',
  'What data or research angles are worth building',
  'How campaigns can support PR, search, social, and AI discovery',
  'Which proof points would make the business case clearer',
];
---

<Layout metadata={metadata}>
  <main class="min-h-screen bg-[#f7f4ee] text-[#141414]">
    <SiteHeader />

    <section class="border-b border-[#141414]/10">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-12 sm:px-6 sm:py-16 lg:grid-cols-[0.9fr_1.1fr] lg:px-8 lg:py-20">
        <aside class="lg:sticky lg:top-8 lg:self-start">
          <p class="inline-flex rounded-sm border border-[#141414]/15 bg-white/60 px-3 py-1 text-sm font-medium text-[#2f5f59]">
            30 minute discovery call
          </p>
          <h1 class="mt-5 text-4xl font-semibold leading-[1.05] tracking-normal sm:text-6xl">
            Book a meeting
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-8 text-[#454545]">
            Pick a slot and share a little context. We want to get to know you better and learn more about your
            challenges.
          </p>

          <div class="mt-8 flex items-center gap-4 rounded-sm border border-[#141414]/10 bg-white p-4">
            <img
              src={ryanProfile.src}
              width={ryanProfile.width}
              height={ryanProfile.height}
              alt="Ryan Green"
              class="h-20 w-20 shrink-0 rounded-sm object-cover"
              loading="eager"
            />
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#2f5f59]">Your host</p>
              <div class="mt-1 flex items-center gap-3">
                <p class="text-lg font-semibold">Ryan Green</p>
                <a
                  href="mailto:hello@citedstories.com"
                  class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-[#141414]/10 text-[#141414] transition hover:border-[#2f5f59]/40 hover:bg-[#dce8d8] hover:text-[#2f5f59]"
                  aria-label="Email Ryan Green"
                >
                  <Icon name="tabler:mail" class="h-4 w-4" />
                </a>
                <a
                  href="https://www.linkedin.com/in/ryangreenio/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-[#141414]/10 text-[#141414] transition hover:border-[#2f5f59]/40 hover:bg-[#dce8d8] hover:text-[#2f5f59]"
                  aria-label="Ryan Green on LinkedIn"
                >
                  <Icon name="tabler:brand-linkedin" class="h-4 w-4" />
                </a>
              </div>
              <p class="mt-2 text-sm leading-6 text-[#555]">Looking forward to meeting you!</p>
            </div>
          </div>

          <div class="mt-8 rounded-sm border border-[#141414]/10 bg-white p-5">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-sm bg-[#dce8d8] text-[#2f5f59]">
                <Icon name="tabler:sparkles" class="h-5 w-5" />
              </span>
              <h2 class="text-lg font-semibold">What we will cover</h2>
            </div>
            <ul class="mt-5 space-y-3">
              {
                discussionPoints.map((item) => (
                  <li class="flex gap-3 text-sm leading-6 text-[#555]">
                    <Icon name="tabler:circle-check" class="mt-0.5 h-5 w-5 shrink-0 text-[#2f5f59]" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </aside>

        <section class="rounded-sm border border-[#141414]/10 bg-white shadow-[0_24px_80px_rgba(20,20,20,0.08)]">
          <form
            id="booking-form"
            action="/.netlify/functions/create-booking"
            method="post"
            class="grid gap-0"
            data-booking-form
          >
            <input type="hidden" name="meeting_type" value="discovery_call" />
            <input type="hidden" name="meeting_duration" value="30" />
            <input type="hidden" name="booking_status" value="confirmed" />
            <input type="hidden" name="form_started_at" data-form-started-at />
            <input type="hidden" name="meeting_date" data-selected-date />
            <input type="hidden" name="meeting_date_label" data-selected-date-label />
            <input type="hidden" name="meeting_time" data-selected-time />
            <input type="hidden" name="meeting_time_label" data-selected-time-label />
            <input type="hidden" name="timezone" data-timezone />
            <label class="absolute left-[-10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
              Website
              <input type="text" name="website" autocomplete="off" tabindex="-1" data-spam-check />
            </label>

            <div class="border-b border-[#141414]/10 bg-[#f7f4ee] px-5 py-4 sm:px-6" aria-live="polite">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#2f5f59]" data-step-indicator>
                  Step 1 of 3
                </p>
                <p class="text-sm font-medium text-[#555]" data-booking-summary>Start by choosing a date.</p>
              </div>
            </div>

            <div class="p-5 sm:p-6" data-step-panel="1">
              <h2 class="text-2xl font-semibold tracking-normal">Choose a date</h2>
              <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-date-options aria-label="Available dates"></div>
              <p
                class="mt-5 hidden rounded-sm border border-[#e2634f]/30 bg-[#fff4ef] px-4 py-3 text-sm font-medium text-[#9a2f21]"
                data-step-error="1"
                tabindex="-1"
              >
                Choose a date to continue.
              </p>
              <div class="mt-6 grid gap-3 sm:grid-cols-2">
                <span class="hidden sm:block" aria-hidden="true"></span>
                <button
                  type="button"
                  class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-sm bg-[#141414] px-6 font-semibold text-white transition hover:bg-[#2f5f59]"
                  data-next-step
                >
                  Continue
                  <Icon name="tabler:arrow-right" class="h-5 w-5" />
                </button>
              </div>
            </div>

            <div class="hidden p-5 sm:p-6" data-step-panel="2">
              <div class="mt-2 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
                <h2 class="text-2xl font-semibold tracking-normal">Choose a time</h2>
                <p class="text-sm text-[#666]" data-timezone-label>Your local time</p>
              </div>
              <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-time-options aria-label="Available times"></div>
              <p
                class="mt-5 hidden rounded-sm border border-[#e2634f]/30 bg-[#fff4ef] px-4 py-3 text-sm font-medium text-[#9a2f21]"
                data-step-error="2"
                tabindex="-1"
              >
                Choose a time to continue.
              </p>
              <div class="mt-6 grid gap-3 sm:grid-cols-2">
                <button
                  type="button"
                  class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-sm border border-[#141414]/20 px-6 font-semibold text-[#141414] transition hover:bg-[#f7f4ee]"
                  data-prev-step
                >
                  <Icon name="tabler:arrow-left" class="h-5 w-5" />
                  Back
                </button>
                <button
                  type="button"
                  class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-sm bg-[#141414] px-6 font-semibold text-white transition hover:bg-[#2f5f59]"
                  data-next-step
                >
                  Continue
                  <Icon name="tabler:arrow-right" class="h-5 w-5" />
                </button>
              </div>
            </div>

            <div class="hidden grid gap-5 p-5 sm:p-6" data-step-panel="3">
              <div>
                <h2 class="text-2xl font-semibold tracking-normal">Tell us where to send the invite</h2>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                <label class="grid gap-2 text-sm font-semibold text-[#343434]">
                  Name
                  <input
                    required
                    type="text"
                    name="name"
                    autocomplete="name"
                    class="h-12 rounded-sm border border-[#141414]/15 bg-[#f7f4ee] px-4 text-base font-normal outline-none transition focus:border-[#2f5f59] focus:bg-white"
                  />
                </label>
                <label class="grid gap-2 text-sm font-semibold text-[#343434]">
                  Work email
                  <input
                    required
                    type="email"
                    name="email"
                    autocomplete="email"
                    class="h-12 rounded-sm border border-[#141414]/15 bg-[#f7f4ee] px-4 text-base font-normal outline-none transition focus:border-[#2f5f59] focus:bg-white"
                  />
                </label>
              </div>

              <label class="grid gap-2 text-sm font-semibold text-[#343434]">
                Company
                <input
                  required
                  type="text"
                  name="company"
                  autocomplete="organization"
                  class="h-12 rounded-sm border border-[#141414]/15 bg-[#f7f4ee] px-4 text-base font-normal outline-none transition focus:border-[#2f5f59] focus:bg-white"
                />
              </label>

              <label class="grid gap-2 text-sm font-semibold text-[#343434]">
                What should we talk about?
                <textarea
                  name="context"
                  rows="4"
                  class="rounded-sm border border-[#141414]/15 bg-[#f7f4ee] px-4 py-3 text-base font-normal outline-none transition focus:border-[#2f5f59] focus:bg-white"
                ></textarea>
              </label>

              <p
                class="hidden rounded-sm border border-[#e2634f]/30 bg-[#fff4ef] px-4 py-3 text-sm font-medium text-[#9a2f21]"
                data-booking-error
                tabindex="-1"
              >
                Choose a date and time before confirming.
              </p>

              <div class="grid gap-3 sm:grid-cols-2">
                <button
                  type="button"
                  class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-sm border border-[#141414]/20 px-6 font-semibold text-[#141414] transition hover:bg-[#f7f4ee]"
                  data-prev-step
                >
                  <Icon name="tabler:arrow-left" class="h-5 w-5" />
                  Back
                </button>
                <button
                  type="submit"
                  class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-sm bg-[#141414] px-6 font-semibold text-white transition hover:bg-[#2f5f59]"
                >
                  Confirm meeting
                  <Icon name="tabler:calendar-check" class="h-5 w-5" />
                </button>
              </div>
            </div>
          </form>
        </section>
      </div>
    </section>

    <SiteFooter />
  </main>

  <script is:inline data-astro-rerun>
    const dateContainer = document.querySelector('[data-date-options]');
    const timeContainer = document.querySelector('[data-time-options]');
    const form = document.querySelector('[data-booking-form]');
    const dateInput = document.querySelector('[data-selected-date]');
    const dateLabelInput = document.querySelector('[data-selected-date-label]');
    const timeInput = document.querySelector('[data-selected-time]');
    const timeLabelInput = document.querySelector('[data-selected-time-label]');
    const timezoneInput = document.querySelector('[data-timezone]');
    const timezoneLabel = document.querySelector('[data-timezone-label]');
    const formStartedAtInput = document.querySelector('[data-form-started-at]');
    const errorMessage = document.querySelector('[data-booking-error]');
    const spamCheckInput = document.querySelector('[data-spam-check]');
    const stepIndicator = document.querySelector('[data-step-indicator]');
    const bookingSummary = document.querySelector('[data-booking-summary]');
    const stepPanels = Array.from(document.querySelectorAll('[data-step-panel]'));
    const stepErrors = Array.from(document.querySelectorAll('[data-step-error]'));
    const nextButtons = Array.from(document.querySelectorAll('[data-next-step]'));
    const prevButtons = Array.from(document.querySelectorAll('[data-prev-step]'));
    const availabilityByDay = {
      1: ['13:00', '19:00', '20:00', '21:00'],
      2: ['13:00', '16:00', '17:00', '18:00', '19:00', '20:00', '21:00'],
      4: ['06:00', '07:00', '08:00', '13:00', '16:00', '17:00', '18:00', '19:00', '20:00', '21:00'],
    };
    const dateFormatter = new Intl.DateTimeFormat(undefined, { weekday: 'short', month: 'short', day: 'numeric' });
    const timeFormatter = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });
    const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone || 'local';
    const formStartedAt = Date.now();
    let currentStep = 1;

    timezoneInput.value = timezone;
    timezoneLabel.textContent = `${timezone.replaceAll('_', ' ')} time`;
    formStartedAtInput.value = String(formStartedAt);

    const getAvailableDates = () => {
      const dates = [];
      const cursor = new Date();
      cursor.setDate(cursor.getDate() + 1);

      while (dates.length < 9) {
        const day = cursor.getDay();
        if (availabilityByDay[day]) {
          dates.push(new Date(cursor));
        }
        cursor.setDate(cursor.getDate() + 1);
      }

      return dates;
    };

    const setSelectedButton = (container, button) => {
      container.querySelectorAll('button').forEach((item) => {
        item.classList.remove('border-[#2f5f59]', 'bg-[#dce8d8]');
        item.classList.add('border-[#141414]/10', 'bg-[#f7f4ee]');
        item.setAttribute('aria-pressed', 'false');
      });
      button.classList.add('border-[#2f5f59]', 'bg-[#dce8d8]');
      button.classList.remove('border-[#141414]/10', 'bg-[#f7f4ee]');
      button.setAttribute('aria-pressed', 'true');
      errorMessage.classList.add('hidden');
    };

    const getDateValue = (date) => {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };

    const getTimeLabel = (time) => {
      const [hours, minutes] = time.split(':').map(Number);
      const date = new Date();
      date.setHours(hours, minutes, 0, 0);
      return timeFormatter.format(date);
    };

    const renderTimeOptions = (day) => {
      timeContainer.replaceChildren();
      timeInput.value = '';
      timeLabelInput.value = '';

      availabilityByDay[day].forEach((time) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className =
          'rounded-sm border border-[#141414]/10 bg-[#f7f4ee] px-4 py-3 text-left text-sm font-semibold transition hover:border-[#2f5f59] hover:bg-[#dce8d8]';
        button.setAttribute('aria-pressed', 'false');
        button.dataset.value = time;
        button.textContent = getTimeLabel(time);
        button.addEventListener('click', () => {
          timeInput.value = button.dataset.value;
          timeLabelInput.value = button.textContent;
          setSelectedButton(timeContainer, button);
          bookingSummary.textContent = getSummaryText();
        });
        timeContainer.append(button);
      });
    };

    const hideStepErrors = () => {
      stepErrors.forEach((item) => item.classList.add('hidden'));
    };

    const getSummaryText = () => {
      if (dateLabelInput.value && timeLabelInput.value) {
        return `${dateLabelInput.value} at ${timeLabelInput.value} (${timezone.replaceAll('_', ' ')} time)`;
      }

      if (dateLabelInput.value) {
        return `${dateLabelInput.value} selected. Now choose a time.`;
      }

      return 'Start by choosing a date.';
    };

    const showStep = (step) => {
      currentStep = step;
      stepPanels.forEach((panel) => {
        panel.classList.toggle('hidden', Number(panel.dataset.stepPanel) !== currentStep);
      });
      stepIndicator.textContent = `Step ${currentStep} of 3`;
      bookingSummary.textContent = getSummaryText();
      hideStepErrors();
      errorMessage.classList.add('hidden');
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    const showStepError = (step) => {
      const stepError = document.querySelector(`[data-step-error="${step}"]`);
      if (!stepError) return;
      stepError.classList.remove('hidden');
      stepError.focus();
    };

    const canLeaveStep = (step) => {
      if (step === 1) return Boolean(dateInput.value);
      if (step === 2) return Boolean(timeInput.value);
      return true;
    };

    getAvailableDates().forEach((date) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className =
        'rounded-sm border border-[#141414]/10 bg-[#f7f4ee] px-4 py-3 text-left transition hover:border-[#2f5f59] hover:bg-[#dce8d8]';
      button.setAttribute('aria-pressed', 'false');
      button.dataset.value = getDateValue(date);
      button.dataset.label = dateFormatter.format(date);
      button.innerHTML = `<span class="block text-sm font-semibold">${button.dataset.label}</span><span class="mt-1 block text-xs text-[#666]">Available</span>`;
      button.addEventListener('click', () => {
        dateInput.value = button.dataset.value;
        dateLabelInput.value = button.dataset.label;
        setSelectedButton(dateContainer, button);
        renderTimeOptions(date.getDay());
        bookingSummary.textContent = getSummaryText();
      });
      dateContainer.append(button);
    });

    nextButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!canLeaveStep(currentStep)) {
          showStepError(currentStep);
          return;
        }

        showStep(Math.min(currentStep + 1, 3));
      });
    });

    prevButtons.forEach((button) => {
      button.addEventListener('click', () => {
        showStep(Math.max(currentStep - 1, 1));
      });
    });

    const getConfirmationPath = (bookingDetails) => {
      const params = new URLSearchParams();
      Object.entries(bookingDetails).forEach(([key, value]) => {
        if (!value || key === 'website' || key === 'form_started_at') return;
        params.set(key, value);
      });
      return `/booking-confirmed?${params.toString()}`;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (spamCheckInput.value || Date.now() - formStartedAt < 2500) {
        return;
      }

      if (!dateInput.value || !timeInput.value) {
        showStep(!dateInput.value ? 1 : 2);
        errorMessage.classList.remove('hidden');
        errorMessage.focus();
        return;
      }

      errorMessage.classList.add('hidden');
      const bookingDetails = Object.fromEntries(new FormData(form).entries());
      sessionStorage.setItem('citedStoriesBooking', JSON.stringify(bookingDetails));

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new URLSearchParams(bookingDetails),
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded',
          },
        });

        const result = await response.json();

        if (response.ok && result.confirmationPath) {
          window.location.href = result.confirmationPath;
          return;
        }

        throw new Error(result.error || 'Booking invite failed');
      } catch {
        errorMessage.textContent =
          'We could not send the calendar invite. Please check the booking email settings and try again.';
        errorMessage.classList.remove('hidden');
        errorMessage.focus();
        return;
      }
    });
  </script>
</Layout>
