---
import { Icon } from 'astro-icon/components';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import Layout from '~/layouts/Layout.astro';
import caseStudiesHeroSticker from '~/assets/images/case-studies/case-studies-hero-sticker.png?url';
import hasbroLogo from '~/assets/images/case-studies/hasbro-monopoly/hasbro-logo.png?url';
import landlordStudioLogo from '~/assets/images/case-studies/landlord-studio/logo.png?url';
import { fetchCaseStudies } from '~/utils/case-studies';
import type { Taxonomy } from '~/types';

const caseStudies = await fetchCaseStudies();
const caseStudyLogoBySlug: Record<string, string> = {
  'hasbro-monopoly': hasbroLogo,
  'landlord-studio': landlordStudioLogo,
};
const filterOptions = Array.from(
  new Map(
    caseStudies
      .flatMap((caseStudy) => [caseStudy.category, ...(caseStudy.tags || [])])
      .filter((item): item is Taxonomy => Boolean(item))
      .map((item) => [item.slug, item.title])
  )
);

const metadata = {
  title: 'Case Studies',
  description: 'Research-led stories, data-led PR campaigns, and citation-worthy work from Cited Stories.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <main class="min-h-screen bg-[#f7f4ee] text-[#141414]">
    <SiteHeader />

    <section class="border-b border-[#141414]/10">
      <div class="mx-auto grid max-w-5xl gap-8 px-5 py-16 sm:px-6 sm:py-20 lg:grid-cols-[minmax(0,48rem)_12rem] lg:items-end lg:px-8">
        <div class="max-w-4xl">
          <h1 class="mt-5 text-5xl font-semibold leading-[1.02] tracking-normal sm:text-6xl">
            Clients we've helped.
          </h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-[#454545] sm:text-xl">
            Explore how we’re helping clients uncover original insights, shape stronger stories, and earn visibility
            across the channels that matter.
          </p>
        </div>
        <div class="flex justify-center self-end lg:justify-end">
          <img
            src={caseStudiesHeroSticker}
            alt="Illustration of a person holding a document"
            class="h-auto w-full max-w-48 object-contain"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto max-w-7xl px-5 py-14 sm:px-6 lg:px-8 lg:py-16">
        <div class="mb-8 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
          <label class="relative block lg:col-span-2">
            <span class="sr-only">Search case studies</span>
            <Icon name="tabler:search" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-[#777]" />
            <input
              type="search"
              placeholder="Search case studies"
              class="h-12 w-full rounded-sm border border-[#141414]/15 bg-[#f7f4ee] pl-11 pr-4 text-base outline-none transition focus:border-[#2f5f59] focus:bg-white"
              data-list-search
            />
          </label>
          <label class="grid gap-2 text-sm font-semibold text-[#343434]">
            <span class="sr-only">Filter case studies</span>
            <select
              class="h-12 rounded-sm border border-[#141414]/15 bg-[#f7f4ee] px-4 text-base font-normal outline-none transition focus:border-[#2f5f59] focus:bg-white"
              data-list-filter
            >
              <option value="">All categories</option>
              {filterOptions.map(([slug, title]) => <option value={slug}>{title}</option>)}
            </select>
          </label>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {
            caseStudies.map((caseStudy) => (
              <a
                href={caseStudy.permalink}
                class="flex min-h-full flex-col rounded-sm border border-[#141414]/10 bg-[#f7f4ee] p-6 text-[#141414] no-underline transition hover:-translate-y-1 hover:border-[#2f5f59]/40 hover:bg-white"
                data-list-item
                data-search-index={`${caseStudy.client} ${caseStudy.title} ${caseStudy.excerpt || caseStudy.subtitle} ${caseStudy.category?.title || ''} ${(caseStudy.tags || []).map((tag) => tag.title).join(' ')}`.toLowerCase()}
                data-filter-index={[caseStudy.category?.slug, ...(caseStudy.tags || []).map((tag) => tag.slug)].filter(Boolean).join(' ')}
              >
                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#2f5f59]">{caseStudy.client}</p>
                <div class="mt-4 flex h-14 w-36 items-center justify-center rounded-sm border border-[#141414]/10 bg-white text-sm font-semibold tracking-normal text-[#777]">
                  {
                    caseStudyLogoBySlug[caseStudy.slug] ? (
                      <img
                        src={caseStudyLogoBySlug[caseStudy.slug]}
                        alt={`${caseStudy.client} logo`}
                        class="max-h-10 max-w-28 object-contain"
                        loading="lazy"
                      />
                    ) : (
                      'Logo'
                    )
                  }
                </div>
                <h2 class="mt-5 text-2xl font-semibold leading-tight tracking-normal">
                  {caseStudy.title}
                </h2>
                <p class="mt-4 leading-7 text-[#555]">{caseStudy.excerpt || caseStudy.subtitle}</p>
                <span class="mt-8 inline-flex items-center gap-2 font-semibold text-[#141414]">
                  Read case study
                  <Icon name="tabler:arrow-right" class="h-5 w-5" />
                </span>
              </a>
            ))
          }
        </div>
        <div class="hidden rounded-sm border border-[#141414]/10 bg-[#f7f4ee] p-8 text-center" data-list-empty>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#2f5f59]">No matches</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-normal">Try another search or filter.</h2>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>

  <script is:inline data-astro-rerun>
    const searchInput = document.querySelector('[data-list-search]');
    const filterSelect = document.querySelector('[data-list-filter]');
    const listItems = Array.from(document.querySelectorAll('[data-list-item]'));
    const emptyState = document.querySelector('[data-list-empty]');

    const updateList = () => {
      const query = searchInput.value.trim().toLowerCase();
      const filter = filterSelect.value;
      let visibleCount = 0;

      listItems.forEach((item) => {
        const matchesSearch = !query || item.dataset.searchIndex.includes(query);
        const matchesFilter = !filter || item.dataset.filterIndex.split(' ').includes(filter);
        const isVisible = matchesSearch && matchesFilter;
        item.classList.toggle('hidden', !isVisible);
        if (isVisible) visibleCount += 1;
      });

      emptyState.classList.toggle('hidden', visibleCount !== 0);
    };

    searchInput.addEventListener('input', updateList);
    filterSelect.addEventListener('change', updateList);
  </script>
</Layout>
