---
import { Icon } from 'astro-icon/components';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import Layout from '~/layouts/Layout.astro';
import ryanProfile from '~/assets/images/about/ryan-profile.jpeg';

const metadata = {
  title: 'Ryan Green',
  description: 'Ryan Green is the founder of Cited Stories, helping brands turn research and original insight into stories worth sharing.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <main class="min-h-screen bg-[#f7f4ee] text-[#141414]">
    <SiteHeader />

    <section class="border-b border-[#141414]/10">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-6 sm:py-20 lg:grid-cols-[0.72fr_1fr] lg:items-center lg:px-8 lg:py-24">
        <div class="max-w-sm">
          <img
            src={ryanProfile.src}
            width={ryanProfile.width}
            height={ryanProfile.height}
            class="aspect-square w-full rounded-sm object-cover"
            alt="Ryan Green"
            loading="eager"
            decoding="async"
          />
        </div>
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#e2634f]">Author</p>
          <h1 class="mt-5 text-5xl font-semibold leading-[1.02] tracking-normal sm:text-6xl">Ryan Green</h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-[#454545] sm:text-xl">
            Ryan Green is the founder of Cited Stories. He helps brands uncover original insight, shape stronger
            stories, and earn visibility across media, search, social, newsletters, and AI-driven discovery.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href="/research"
              class="inline-flex items-center justify-center gap-2 rounded-sm bg-[#141414] px-6 py-3.5 font-semibold text-white transition hover:bg-[#2f5f59]"
            >
              Read Ryan's insights
              <Icon name="tabler:book-2" class="h-5 w-5" />
            </a>
            <a
              href="https://www.linkedin.com/in/ryangreenio/"
              class="inline-flex items-center justify-center gap-2 rounded-sm border border-[#141414]/20 bg-white/60 px-6 py-3.5 font-semibold text-[#141414] transition hover:border-[#141414]/40 hover:bg-white"
              rel="noopener noreferrer"
              target="_blank"
            >
              LinkedIn
              <Icon name="tabler:brand-linkedin" class="h-5 w-5" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 lg:px-8 lg:py-20">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#2f5f59]">Latest article</p>
          <a
            href="/research/do-brand-mentions-shape-visibility"
            class="mt-5 block rounded-sm border border-[#141414]/10 bg-[#f7f4ee] p-6 text-[#141414] no-underline transition hover:-translate-y-1 hover:border-[#2f5f59]/40 hover:bg-white"
          >
            <h2 class="text-2xl font-semibold tracking-normal">Do Brand Mentions Shape Visibility?</h2>
            <p class="mt-4 leading-7 text-[#555]">
              A look at how brand mentions can influence visibility across search, media, AI, and the channels that
              shape trust.
            </p>
            <span class="mt-6 inline-flex items-center gap-2 font-semibold">
              Read the article
              <Icon name="tabler:arrow-right" class="h-5 w-5" />
            </span>
          </a>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Layout>
