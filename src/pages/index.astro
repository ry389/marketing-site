---
import { Icon } from 'astro-icon/components';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import Layout from '~/layouts/Layout.astro';
import createSomethingUsefulIcon from '~/assets/images/home/create-something-useful.png?url';
import earnTrustedVisibilityIcon from '~/assets/images/home/earn-trusted-visibility.png?url';
import findWhatMattersIcon from '~/assets/images/home/find-what-matters.png?url';
import visibilityShiftSticker from '~/assets/images/home/visibility-shift-sticker.png?url';

const metadata = {
  title: 'Building the world\'s thought-leading brands',
  description:
    'We create research-led stories that help brands earn trust, visibility, and authority across the channels that matter.',
  ignoreTitleTemplate: true,
};

const whatWeDo = [
  {
    title: 'Find what matters',
    description: 'Uncover the data, trends, and questions your audience actually cares about.',
    icon: findWhatMattersIcon,
  },
  {
    title: 'Create something useful',
    description: 'Turn research into stories, reports, and insights people want to read, reference, and share.',
    icon: createSomethingUsefulIcon,
  },
  {
    title: 'Earn trusted visibility',
    description:
      'Build the kind of presence that helps your brand show up across media, search, social, and AI-driven discovery.',
    icon: earnTrustedVisibilityIcon,
  },
];

const methods = [
  {
    title: 'Data-led PR campaigns',
    description: 'Original research, surveys, reports, indexes, rankings, and data stories.',
  },
  {
    title: 'Authority-building SEO/AEO',
    description: 'Content assets designed to earn mentions, links, and long-term organic visibility.',
  },
  {
    title: 'Thought leadership strategy',
    description: 'Positioning, messaging, expert commentary, and insight development.',
  },
  {
    title: 'Research and insight production',
    description: 'Desk research, data analysis, trend reports, and proprietary content.',
  },
];

---

<Layout metadata={metadata}>
  <main class="min-h-screen bg-[#f7f4ee] text-[#141414]">
    <SiteHeader />

    <section class="relative overflow-hidden border-b border-[#141414]/10">
      <div class="absolute inset-y-0 right-0 hidden w-1/2 bg-[#f7f4ee] lg:block"></div>
      <div class="relative mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-6 sm:py-20 lg:grid-cols-[1.22fr_0.78fr] lg:items-center lg:px-8 lg:py-24 xl:grid-cols-[1.05fr_0.95fr]">
        <div class="max-w-5xl">
          <h1 class="max-w-5xl text-5xl font-semibold leading-[1.05] tracking-normal text-[#141414] sm:text-6xl lg:text-[clamp(3.8rem,5vw,5.6rem)]">
            Get your organisation seen for the work that matters.
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-[#343434] sm:text-xl">
            We create research-led stories that help brands earn trust, visibility, and authority across the channels
            that matter.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a
              href="/contact"
              class="inline-flex items-center justify-center gap-2 rounded-sm bg-[#141414] px-6 py-3.5 text-base font-semibold text-white transition hover:bg-[#2f5f59]"
            >
              Contact us
              <Icon name="tabler:calendar-event" class="h-5 w-5" />
            </a>
          </div>
        </div>

        <div class="self-end">
          <svg
            viewBox="0 0 560 420"
            role="img"
            aria-label="Brand signal map with Your Brand connected to perception, voice, mentions, citations, traffic, authority, and sentiment"
            class="brand-signal-map h-auto w-full"
          >
            <circle class="brand-core" cx="280" cy="208" r="72" fill="#141414" />
            <circle class="signal-ring signal-ring-inner" cx="280" cy="208" r="138" fill="none" stroke="#141414" stroke-opacity="0.10" stroke-width="1.5" />
            <circle class="signal-ring signal-ring-outer" cx="280" cy="208" r="184" fill="none" stroke="#141414" stroke-opacity="0.07" stroke-width="1.5" />

            <g class="signal-connectors" stroke="#141414" stroke-opacity="0.18" stroke-width="2">
              <path d="M280 124V74" />
              <path d="M346 156l72-48" />
              <path d="M363 211h80" />
              <path d="M341 267l78 62" />
              <path d="M280 292v58" />
              <path d="M219 267l-80 62" />
              <path d="M197 211h-78" />
              <path d="M215 154l-72-48" />
            </g>

            <g class="signal-node" tabindex="0">
              <rect x="203" y="42" width="154" height="54" rx="3" fill="#ffffff" stroke="#141414" stroke-opacity="0.12" />
              <text x="280" y="75" text-anchor="middle" fill="#141414" font-family="Inter, sans-serif" font-size="16" font-weight="800">
                Share of voice
              </text>
            </g>

            <g class="signal-node" tabindex="0">
              <rect x="378" y="74" width="154" height="54" rx="3" fill="#ffffff" stroke="#141414" stroke-opacity="0.12" />
              <text x="455" y="107" text-anchor="middle" fill="#141414" font-family="Inter, sans-serif" font-size="16" font-weight="800">
                Brand sentiment
              </text>
            </g>

            <g class="signal-node" tabindex="0">
              <rect x="407" y="184" width="116" height="54" rx="3" fill="#ffffff" stroke="#141414" stroke-opacity="0.12" />
              <text x="465" y="217" text-anchor="middle" fill="#141414" font-family="Inter, sans-serif" font-size="16" font-weight="800">
                Credibility
              </text>
            </g>

            <g class="signal-node" tabindex="0">
              <rect x="365" y="306" width="166" height="54" rx="3" fill="#ffffff" stroke="#141414" stroke-opacity="0.12" />
              <text x="448" y="339" text-anchor="middle" fill="#141414" font-family="Inter, sans-serif" font-size="15" font-weight="800">
                Brand mentions
              </text>
            </g>

            <g class="signal-node" tabindex="0">
              <rect x="203" y="330" width="154" height="54" rx="3" fill="#ffffff" stroke="#141414" stroke-opacity="0.12" />
              <text x="280" y="363" text-anchor="middle" fill="#141414" font-family="Inter, sans-serif" font-size="16" font-weight="800">
                Global perception
              </text>
            </g>

            <g class="signal-node" tabindex="0">
              <rect x="28" y="306" width="172" height="54" rx="3" fill="#ffffff" stroke="#141414" stroke-opacity="0.12" />
              <text x="114" y="339" text-anchor="middle" fill="#141414" font-family="Inter, sans-serif" font-size="15" font-weight="800">
                Local Perception
              </text>
            </g>

            <g class="signal-node" tabindex="0">
              <rect x="38" y="184" width="128" height="54" rx="3" fill="#ffffff" stroke="#141414" stroke-opacity="0.12" />
              <text x="102" y="217" text-anchor="middle" fill="#141414" font-family="Inter, sans-serif" font-size="16" font-weight="800">
                AI citations
              </text>
            </g>

            <g class="signal-node" tabindex="0">
              <rect x="28" y="74" width="156" height="54" rx="3" fill="#ffffff" stroke="#141414" stroke-opacity="0.12" />
              <text x="106" y="107" text-anchor="middle" fill="#141414" font-family="Inter, sans-serif" font-size="16" font-weight="800">
                Media reach
              </text>
            </g>

            <text x="280" y="200" text-anchor="middle" fill="#ffffff" font-family="Inter, sans-serif" font-size="27" font-weight="800">
              Your
            </text>
            <text x="280" y="232" text-anchor="middle" fill="#ffffff" font-family="Inter, sans-serif" font-size="27" font-weight="800">
              Brand
            </text>
          </svg>
        </div>
      </div>
    </section>

    <section class="border-b border-[#141414]/10 bg-white">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:px-8 lg:py-20">
        <div class="flex items-center justify-center lg:justify-start">
          <img
            src={visibilityShiftSticker}
            alt="Illustration of a person using a laptop"
            class="h-auto w-full max-w-[18rem] object-contain sm:max-w-sm"
            loading="lazy"
          />
        </div>
        <div class="lg:self-center">
          <h2 class="mt-5 text-3xl font-bold tracking-normal text-[#141414] sm:text-5xl">
            AI content is easier to produce, but harder to make perform.
          </h2>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-[#454545]">
            AI Overviews are cutting clicks by up to 58%, putting teams under pressure to prove visibility beyond
            traditional SEO. The next era of organic content won’t be won by publishing more generic articles, but by
            creating original insights, credible data, and stories that earn attention.
          </p>
        </div>
      </div>
    </section>

    <section id="method" class="border-b border-[#141414]/10">
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 lg:px-8 lg:py-20">
        <div class="max-w-2xl">
          <h2 class="mt-4 text-3xl font-semibold tracking-normal sm:text-5xl">
            Brands that get cited are the the brands that get seen.
          </h2>
        </div>
        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {
            whatWeDo.map((item) => (
              <article class="rounded-sm border border-[#141414]/10 bg-white p-6 text-center">
                <img src={item.icon} alt="" class="mx-auto h-20 w-20 object-contain" loading="lazy" />
                <h3 class="mt-8 text-xl font-semibold">{item.title}</h3>
                <p class="mt-3 leading-7 text-[#555]">{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="border-b border-[#141414]/10 bg-[#141414] text-white">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-6 lg:grid-cols-[0.75fr_1.25fr] lg:px-8 lg:py-20">
        <div>
          <h2 class="mt-4 text-3xl font-semibold tracking-normal sm:text-5xl">
            You bring the expertise. We help your brand be recognised for it.
          </h2>
          <a href="/services" class="mt-6 inline-flex font-semibold text-white underline decoration-[#f2c36b] decoration-2 underline-offset-4 hover:text-[#f2c36b]">
            Learn about our services
          </a>
        </div>
        <div class="grid gap-px overflow-hidden rounded-sm border border-white/10 bg-white/10 sm:grid-cols-2">
          {
            methods.map((item) => (
              <article class="bg-[#141414] p-6">
                <h3 class="text-xl font-semibold">{item.title}</h3>
                <p class="mt-3 leading-7 text-white/68">{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="contact" class="border-b border-[#141414]/10 bg-white text-[#141414]">
      <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 sm:px-6 lg:grid-cols-[1fr_auto] lg:items-center lg:px-8">
        <div>
          <h2 class="mt-4 text-3xl font-semibold tracking-normal sm:text-5xl">Ready to share your stories?</h2>
          <p class="mt-4 max-w-2xl text-lg leading-8 text-[#555]">
            Let us map the research angles, proof points, and stories your category can own.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 rounded-sm bg-[#141414] px-6 py-3.5 font-semibold text-white transition hover:bg-[#2f5f59]"
          >
            Contact us
            <Icon name="tabler:arrow-up-right" class="h-5 w-5" />
          </a>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Layout>

<style>
  .brand-signal-map .brand-core,
  .brand-signal-map .signal-ring,
  .brand-signal-map .signal-connectors,
  .brand-signal-map .signal-node,
  .brand-signal-map .signal-node rect {
    transition:
      opacity 220ms ease,
      stroke-opacity 220ms ease,
      filter 220ms ease,
      transform 220ms ease;
  }

  .brand-signal-map .signal-node {
    cursor: pointer;
    transform-box: fill-box;
    transform-origin: center;
    outline: none;
  }

  .brand-signal-map .signal-node text {
    pointer-events: none;
  }

  .brand-signal-map:hover .brand-core,
  .brand-signal-map:focus-within .brand-core {
    transform: scale(1.04);
    transform-origin: 280px 208px;
    filter: drop-shadow(0 14px 22px rgb(20 20 20 / 0.18));
  }

  .brand-signal-map:hover .signal-connectors,
  .brand-signal-map:focus-within .signal-connectors {
    stroke-opacity: 0.34;
  }

  .brand-signal-map:hover .signal-ring-inner,
  .brand-signal-map:focus-within .signal-ring-inner {
    stroke-opacity: 0.18;
  }

  .brand-signal-map:hover .signal-ring-outer,
  .brand-signal-map:focus-within .signal-ring-outer {
    stroke-opacity: 0.12;
  }

  .brand-signal-map .signal-node:hover,
  .brand-signal-map .signal-node:focus-visible {
    transform: translateY(-5px) scale(1.035);
  }

  .brand-signal-map .signal-node:hover rect,
  .brand-signal-map .signal-node:focus-visible rect {
    stroke-opacity: 0.32;
    filter: drop-shadow(0 10px 16px rgb(20 20 20 / 0.14));
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-signal-map .brand-core,
    .brand-signal-map .signal-ring,
    .brand-signal-map .signal-connectors,
    .brand-signal-map .signal-node,
    .brand-signal-map .signal-node rect {
      transition: none;
    }
  }
</style>
