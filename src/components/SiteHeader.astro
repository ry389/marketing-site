---
import { Icon } from 'astro-icon/components';
---

<header class="border-b border-[#141414]/10 bg-[#f7f4ee]/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-3 font-semibold tracking-normal text-[#141414]">
      <span class="flex h-9 w-9 items-center justify-center rounded-sm bg-[#141414] text-sm text-white">
        C<span class="underline decoration-white decoration-2 underline-offset-2">S</span>
      </span>
      <span>Cited Stories</span>
    </a>
    <nav class="hidden items-center gap-8 text-sm font-medium text-[#141414]/70 md:flex" aria-label="Main navigation">
      <a class="hover:text-[#141414]" href="/case-studies">Case Studies</a>
      <a class="hover:text-[#141414]" href="/research">Research</a>
    </nav>
    <a
      href="/book-a-meeting"
      class="hidden items-center gap-2 rounded-sm bg-[#141414] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#2f5f59] sm:inline-flex"
    >
      Book a discovery call
      <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
    </a>
  </div>
</header>
