---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
const authorUrlByName: Record<string, string> = {
  'Ryan Green': '/author/ryan-green',
};
const authorUrl = post.author ? authorUrlByName[post.author] : undefined;
---

<section class="border-b border-[#141414]/10">
  <article>
    <header>
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-6 sm:py-20 lg:px-8">
        <a href="/" class="inline-flex w-fit items-center gap-2 text-sm font-semibold text-[#2f5f59] hover:text-[#141414]">
          <Icon name="tabler:arrow-left" class="h-4 w-4" />
          Home
        </a>
        <div class="max-w-4xl">
          <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-medium text-[#666]">
            <Icon name="tabler:calendar" class="h-4 w-4 text-[#2f5f59]" />
          <time datetime={String(post.publishDate)} class="inline-block">{getFormattedDate(post.publishDate)}</time>
          {
            post.author && (
              <>
                  <span aria-hidden="true">·</span>
                  <Icon name="tabler:user" class="h-4 w-4 text-[#2f5f59]" />
                  {
                    authorUrl ? (
                      <a class="inline-block font-semibold text-[#2f5f59] hover:text-[#141414]" href={authorUrl}>
                        {post.author}
                      </a>
                    ) : (
                      <span class="inline-block">{post.author}</span>
                    )
                  }
              </>
            )
          }
          {
            post.category && (
              <>
                  <span aria-hidden="true">·</span>
                  <a class="inline-block font-semibold text-[#2f5f59] hover:text-[#141414]" href={getPermalink(post.category.slug, 'category')}>
                  {post.category.title}
                </a>
              </>
            )
          }
          {
            post.readingTime && (
              <>
                  <span aria-hidden="true">·</span>
                  <span>{post.readingTime} min read</span>
              </>
            )
          }
          </p>

          <h1 class="mt-5 text-5xl font-semibold leading-[1.02] tracking-normal sm:text-6xl">{post.title}</h1>
          {post.excerpt && <p class="mt-6 max-w-3xl text-lg leading-8 text-[#454545] sm:text-xl">{post.excerpt}</p>}
        </div>
      </div>

      {
        post.image ? (
          <div class="border-y border-[#141414]/10 bg-white">
            <div class="mx-auto max-w-7xl px-5 py-6 sm:px-6 lg:px-8">
              <Image
                src={post.image}
                class="aspect-[16/8] w-full rounded-sm border border-[#141414]/10 bg-[#dce8d8] object-cover"
                widths={[800, 1200, 1600]}
                sizes="(max-width: 900px) 100vw, 1200px"
                alt={post.title}
                width={1200}
                height={600}
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        ) : (
          <div class="border-t border-[#141414]/10" />
        )
      }
    </header>
    <div
      class="prose prose-lg mx-auto max-w-3xl px-5 py-14 prose-headings:font-semibold prose-headings:tracking-normal prose-headings:text-[#141414] prose-p:leading-8 prose-p:text-[#454545] prose-a:text-[#2f5f59] prose-strong:text-[#141414] prose-ul:text-[#454545] prose-li:my-1 sm:px-6 lg:py-20"
    >
      <slot />
    </div>
    <div class="mx-auto flex max-w-3xl flex-col gap-4 px-5 pb-16 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:pb-20">
      <a href="/" class="inline-flex items-center gap-2 font-semibold text-[#141414] hover:text-[#2f5f59]">
        <Icon name="tabler:arrow-left" class="h-5 w-5" />
        Back home
      </a>
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 rounded-sm bg-[#141414] px-5 py-3 font-semibold text-white transition hover:bg-[#2f5f59]"
      >
        Contact us
        <Icon name="tabler:arrow-up-right" class="h-5 w-5" />
      </a>
    </div>
  </article>
</section>
