---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

{
  link ? (
    <a
      href={link}
      class="group mb-6 block no-underline transition intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
      aria-label={`Read ${post.title}`}
    >
      <div class="relative mb-6 rounded bg-gray-400 shadow-lg dark:bg-slate-700 md:h-64">
        {image && (
          <Image
            src={image}
            class="w-full rounded bg-gray-400 shadow-lg dark:bg-slate-700 md:h-full"
            widths={[400, 900]}
            width={400}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.title}
            aspectRatio="16:9"
            layout="cover"
            loading="lazy"
            decoding="async"
          />
        )}
      </div>

      <h3 class="mb-2 text-xl font-bold leading-tight font-heading dark:text-slate-300 sm:text-2xl">
        <span class="inline-block transition duration-200 ease-in group-hover:text-primary dark:group-hover:text-blue-700">
          {post.title}
        </span>
      </h3>

      <p class="text-lg text-muted dark:text-slate-400">{post.excerpt}</p>
    </a>
  ) : (
    <article class="mb-6 transition intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
      <div class="relative mb-6 rounded bg-gray-400 shadow-lg dark:bg-slate-700 md:h-64">
        {image && (
          <Image
            src={image}
            class="w-full rounded bg-gray-400 shadow-lg dark:bg-slate-700 md:h-full"
            widths={[400, 900]}
            width={400}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.title}
            aspectRatio="16:9"
            layout="cover"
            loading="lazy"
            decoding="async"
          />
        )}
      </div>

      <h3 class="mb-2 text-xl font-bold leading-tight font-heading dark:text-slate-300 sm:text-2xl">{post.title}</h3>

      <p class="text-lg text-muted dark:text-slate-400">{post.excerpt}</p>
    </article>
  )
}
